# Defaults for /etc/cube-e2b-shim.env.
# Override with `systemctl edit cube-e2b-shim`.

# E2B-facing API keys (comma-separated). Generate per deployer; never reuse
# across staging/production. The shim accepts these on the control-plane
# surface; the CubeAPI key stays server-side only.
SHIM_API_KEYS=

# CubeAPI base URL and key. CUBE_API_KEY is the single backend credential
# the shim forwards to to CubeAPI. Keep it root-only.
CUBE_API_URL=http://127.0.0.1:3000
CUBE_API_KEY=

# Public domain the shim advertises in sandbox responses and serves on the
# edge surface (`<port>-<id>.${SHIM_DOMAIN}` plus `sandbox.${SHIM_DOMAIN}`).
# The cloudflared tunnel records must route this domain (and a wildcard
# record for the edge) to the local listener.
SHIM_DOMAIN=

# cube-proxy base URL used by the edge surface (Host rewriting onto Cube's
# internal domain).
CUBE_PROXY_URL=http://192.168.9.100
CUBE_DOMAIN=cube.app

# SQLite state (required). It holds every issued envd token, so it must be a
# durable file: resume / connect / envd traffic only keep working across
# restarts when this survives. `:memory:` is accepted for throwaway dev only.
SHIM_DB_PATH=/var/lib/cube-e2b-shim/shim.db

# Optional bind address. Empty/undefined binds all interfaces (default). Set
# this to the private address the gateway host is allowed to reach.
# SHIM_LISTEN_HOST=172.31.6.248

# E2B template builds. COPY archives uploaded by Template.build() are stored
# here (default: template-files/ next to SHIM_DB_PATH).
# SHIM_BUILD_FILES_DIR=/var/lib/cube-e2b-shim/template-files
# Writable layer size for Cube templates built from `fromImage` (default 4G).
# SHIM_TEMPLATE_DISK_SIZE=4G
# Public origin placed in template file upload URLs. Only needed when the
# request Host / X-Forwarded-Proto seen by the shim is not what clients use.
# SHIM_PUBLIC_API_URL=https://api.example.com

# E2B account and admin credentials. Access tokens (Bearer) are required for
# GET /teams and API key management; the admin token enables the admin APIs.
# SHIM_ACCESS_TOKENS=
# SHIM_ADMIN_TOKEN=
# SHIM_TEAM_NAME=default
# Encryption key for secrets and webhook signing secrets at rest (32 bytes,
# hex or base64). When unset a key is generated and kept in the database;
# set it to keep the key out of the database file.
# SHIM_ENCRYPTION_KEY=

# Sandbox lifecycle events: poll interval for changes Cube makes on its own,
# and retention for events, webhook deliveries and team metrics.
# SHIM_EVENT_POLL_SECONDS=15
# SHIM_EVENT_RETENTION_DAYS=7

# Template for the helper sandboxes behind the volume content API.
# SHIM_VOLUME_HELPER_TEMPLATE=base

# CubeOps, for the admin node APIs (GET/POST /nodes).
# CUBE_OPS_URL=http://127.0.0.1:3010
# CUBE_OPS_TOKEN=
# SHIM_CLUSTER_ID=00000000-0000-4000-8000-000000000001
