# Defaults for /etc/cube-e2b-shim.env.
# Override with `systemctl edit cube-e2b-shim`.

# E2B-facing API keys (comma-separated). Generate per deployer; never reuse
# across staging/production. The shim accepts these on the control-plane
# surface; the CubeAPI key stays server-side only.
SHIM_API_KEYS=

# CubeAPI base URL and key. CUBE_API_KEY is the single backend credential
# the shim forwards to to CubeAPI. Keep it root-only.
CUBE_API_URL=http://127.0.0.1:3000
CUBE_API_KEY=

# Public domain the shim advertises in sandbox responses and serves on the
# edge surface (`<port>-<id>.${SHIM_DOMAIN}` plus `sandbox.${SHIM_DOMAIN}`).
# The cloudflared tunnel records must route this domain (and a wildcard
# record for the edge) to the local listener.
SHIM_DOMAIN=

# cube-proxy base URL used by the edge surface (Host rewriting onto Cube's
# internal domain).
CUBE_PROXY_URL=http://192.168.9.100
CUBE_DOMAIN=cube.app

# SQLite state. :memory: loses envd tokens on restart; use a file in
# production so resume / connect work after restarts.
SHIM_DB_PATH=/var/lib/cube-e2b-shim/shim.db

# Optional bind address. Empty/undefined binds all interfaces (default). Set
# this to the private address the gateway host is allowed to reach.
# SHIM_LISTEN_HOST=172.31.6.248
